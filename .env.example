# Contact form email delivery (SMTP, sent through Shivani's own Gmail).
# Add these in Vercel: Project > Settings > Environment Variables, then redeploy.
#
# For Gmail, SMTP_PASS must be an "App password", not the normal Gmail password:
# Google Account > Security > turn on 2-Step Verification > App passwords > create one.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=shivanimittal1705@gmail.com
SMTP_PASS=

# Optional. Where messages are delivered. Defaults to the email address in lib/data.ts.
EMAIL_TO=
